# Local sync credentials used by Anki clients. These are not AnkiWeb credentials.
# Use a unique password and keep the installed file mode 0640 or stricter.
SYNC_USER1=replace-with-local-sync-username:replace-with-local-sync-password

# The server's private collection and media storage.
SYNC_BASE=/var/lib/anki-beeminder/sync

# Bind to the LAN/VPN interface only. Restrict this port with the host firewall.
SYNC_HOST=0.0.0.0
SYNC_PORT=8080
