# Path to the collection stored by the official sync server.
ANKI_COLLECTION_PATH=/var/lib/anki-beeminder/sync/collection.anki2
ANKI_DECK_FILTER=
ANKI_TIMEZONE=Europe/Ljubljana

BEEMINDER_USER=replace-with-beeminder-username
BEEMINDER_TOKEN=replace-with-beeminder-api-token
BEEMINDER_GOAL=replace-with-goal-slug
